    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_core",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "updater:libupdaterlog",
    "updater:libutils",
  ]
  branch_protector_ret = "pac_ret"
  part_name = "sys_installer"
  subsystem_name = "updater"
